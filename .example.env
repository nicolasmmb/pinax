# Pinax - arquivo de exemplo
# Copie para .env e ajuste os valores:
#   cp .example.env .env
# Precedência: padrões -> .env -> variáveis do processo.

# ---------------------------------------------------------------------------
# Documentos e banco
# ---------------------------------------------------------------------------

# Obrigatório. Apenas arquivos dentro desta pasta podem ser indexados.
PINAX_DOCUMENT_ROOT=/caminho/absoluto/para/documents

# Banco Turso local. O socket do worker é derivado deste caminho.
PINAX_DATABASE_PATH=/caminho/absoluto/para/data/pinax.db

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

# ollama ou openai.
EMBED_PROVIDER=ollama

# URL base da API.
# Ollama:  http://127.0.0.1:11434
# OpenAI:  https://api.openai.com/v1
EMBED_URL=http://127.0.0.1:11434

# Modelo de embedding.
# Ollama: padrão embeddinggemma-2:740m.
# OpenAI: obrigatório.
EMBED_MODEL=embeddinggemma-2:740m

# Chave da API. Deixe vazio para Ollama.
EMBED_API_KEY=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Arquivos em paralelo e limite de jobs ativos. Mínimo 1.
PINAX_WORKER_CONCURRENCY=4

# Chunks enviados por chamada de embedding. Mínimo 1.
PINAX_EMBED_BATCH_SIZE=64

# Intervalo de heartbeat do worker e dos jobs (ex.: 5s, 30s, 1m).
# A recuperação de jobs mortos espera max(6 x heartbeat, 30s).
PINAX_WORKER_HEARTBEAT=5s

# Retenção de jobs terminados em dias. 0 desliga a limpeza.
PINAX_JOB_RETENTION_DAYS=30

# debug, info, warn ou error.
PINAX_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Observações
# ---------------------------------------------------------------------------
# - Não coloque as flags CGO do PDF Oxide neste arquivo. Elas são necessárias
#   para compilar o binário e devem ficar no shell ou no opencode.json.
# - Só pode existir um worker por banco. O segundo falha ao iniciar.
# - Após mudança de schema, apague data/pinax.db, data/pinax.db-wal e data/pinax.db-shm.
